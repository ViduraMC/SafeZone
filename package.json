{
  "name": "safezone",
  "private": true,
  "version": "2.0.0",
  "description": "SafeZone - Smart Disaster Early-Warning and Emergency Coordination System for Sri Lanka (SE3070 Assignment 02). React Native mobile app built with Expo.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest",
    "test:logic": "vitest run",
    "test:ui": "jest",
    "coverage": "vitest run --coverage",
    "screenshots": "expo export --platform web && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.27",
    "expo-image-picker": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^3.2.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright-core": "^1.63.0",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
