!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #1B2F6E
skinparam ArrowFontSize 10
skinparam ArrowFontColor #33415C
skinparam ClassBorderColor #1B2F6E
skinparam ClassBackgroundColor #F6F8FC
skinparam ClassHeaderBackgroundColor #E2E9F6
skinparam ClassFontStyle bold
skinparam ClassAttributeFontSize 11
skinparam StereotypeFontSize 10
skinparam PackageBorderColor #8A9CC4
skinparam PackageBackgroundColor #FCFDFF
skinparam PackageFontColor #1B2F6E
skinparam UsecaseBorderColor #1B2F6E
skinparam UsecaseBackgroundColor #F6F8FC
skinparam ActorBorderColor #1B2F6E
skinparam ActorBackgroundColor white
skinparam RectangleBorderColor #1B2F6E
skinparam ParticipantBorderColor #1B2F6E
skinparam ParticipantBackgroundColor #EEF2FA
skinparam SequenceLifeLineBorderColor #8A9CC4
skinparam SequenceGroupBorderColor #8A9CC4
skinparam SequenceGroupHeaderFontColor #1B2F6E
skinparam SequenceBoxBorderColor #8A9CC4
skinparam NoteBackgroundColor #FFF8E6
skinparam NoteBorderColor #C9A227
skinparam EnumBackgroundColor #FBF7EE
skinparam InterfaceBackgroundColor #EEF6F1
hide empty members
